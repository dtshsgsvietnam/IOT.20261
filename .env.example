# Copy thành .env rồi sửa nếu cần
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=smart_parking

# Để trống khi mosquitto cho phép anonymous (dev)
MQTT_USERNAME=
MQTT_PASSWORD=

# Thiết bị không gửi gì sau N giây -> đánh dấu OFFLINE
DEVICE_TIMEOUT_SEC=30
# Sau khi mở barrier, xe phải qua cổng trong N giây
GATE_PASS_TIMEOUT_SEC=20

